    <string name="perm_open_settings">Open phone settings</string>
    <string name="perm_allowed">Allowed</string>
    <string name="perm_denied">Not allowed</string>
    <string name="perm_notif">Notifications</string>
    <string name="perm_notif_short">So you get check-in messages</string>
    <string name="perm_notif_why">Simha shows a message on your screen when it is time to check on you.</string>
    <string name="perm_notif_no">Without this, you may miss check-in messages</string>
    <string name="perm_mic">Microphone</string>
    <string name="perm_mic_short">So you can talk to Simha</string>
    <string name="perm_mic_why">Simha listens only when you talk to it or answer a check-in</string>
    <string name="perm_mic_no">Without this, you can still answer with the buttons</string>
    <string name="perm_cam">Camera</string>
    <string name="perm_cam_short">So Simha can look at something when you ask</string>
    <string name="perm_cam_why">The camera opens only when you ask Simha to look. The photo is sent to your AI assistant to describe it.</string>
    <string name="perm_cam_no">Without this, Simha cannot look at things for you</string>
    <string name="perm_loc">Location</string>
    <string name="perm_loc_short">Only shared when you ask for help or in an alert</string>
    <string name="perm_loc_why">Your location is added to an alert text to your family only when you need help.</string>
    <string name="perm_loc_no">Without this, alerts will not say where you are</string>
    <string name="perm_usage">Phone activity</string>
    <string name="perm_usage_short">So Simha knows you are using your phone</string>
    <string name="perm_usage_why">Simha sees only when you last used your phone. It never reads your messages or other apps.</string>
    <string name="perm_usage_no">Without this, Simha will ask how you are at set times instead.</string>
    <string name="perm_full">Show check-ins on screen</string>
    <string name="perm_full_short">So the check-in opens even when the phone is locked</string>
    <string name="perm_full_why">Android needs your permission to let Simha open a full screen check-in.</string>
    <string name="perm_full_no">Without this, check-ins appear only as a notification</string>
    <string name="perm_batt">Keep running</string>
    <string name="perm_batt_short">So Simha is not stopped by battery saving</string>
    <string name="perm_batt_why">Phones sometimes stop apps to save battery. This keeps Simha watching over you.</string>
    <string name="perm_batt_no">Without this, the phone may stop Simha</string>
    <string name="perm_call">Phone calls</string>
    <string name="perm_call_short">So Simha can call your family for you</string>
    <string name="perm_call_no">Phone calls are not allowed. Simha will open the dialer and you press call.</string>
    <string name="perm_call_allowed">Phone calls are allowed</string>

